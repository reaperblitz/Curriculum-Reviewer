{
  "$schema": "https://opencode.ai/config.json",
  // ไม่บังคับโมเดล — เรียก bare `opencode --standalone run` ให้ opencode เลือกดีฟอลต์เอง
  // ถ้าอยากบังคับ ตั้ง Variables: OPENCODE_MODEL
  "default_agent": "auditor",
  "agents": {
    "auditor": {
      "description": "หัวหน้าผู้ตรวจหลักสูตร อ่านเกณฑ์ใน pdf/ เองแล้วตรวจไฟล์เป้าหมาย",
      "mode": "primary",
      "steps": 30,
      "permissions": [
        { "action": "read", "resource": "pdf/**/*", "effect": "allow" },
        { "action": "read", "resource": "curriculums/**/*", "effect": "allow" },
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "grep", "resource": "*", "effect": "allow" },
        { "action": "write", "resource": "reports/**/*", "effect": "allow" },
        { "action": "edit", "resource": "reports/**/*", "effect": "allow" },
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "compliance-voter", "effect": "allow" },
        { "action": "subagent", "resource": "quality-voter", "effect": "allow" },
        { "action": "subagent", "resource": "completeness-voter", "effect": "allow" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "webfetch", "resource": "*", "effect": "deny" },
        { "action": "websearch", "resource": "*", "effect": "deny" }
      ]
    },
    "compliance-voter": {
      "description": "โหวต APPROVE/DENY ด้านเกณฑ์บังคับ",
      "mode": "all",
      "steps": 10,
      "permissions": [
        { "action": "read", "resource": "pdf/**/*", "effect": "allow" },
        { "action": "read", "resource": "curriculums/**/*", "effect": "allow" },
        { "action": "read", "resource": "reports/**/*", "effect": "allow" },
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "grep", "resource": "*", "effect": "allow" },
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "webfetch", "resource": "*", "effect": "deny" },
        { "action": "websearch", "resource": "*", "effect": "deny" }
      ]
    },
    "quality-voter": {
      "description": "โหวต APPROVE/DENY ด้านคุณภาพวิชาการ",
      "mode": "all",
      "steps": 10,
      "permissions": [
        { "action": "read", "resource": "pdf/**/*", "effect": "allow" },
        { "action": "read", "resource": "curriculums/**/*", "effect": "allow" },
        { "action": "read", "resource": "reports/**/*", "effect": "allow" },
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "grep", "resource": "*", "effect": "allow" },
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "webfetch", "resource": "*", "effect": "deny" },
        { "action": "websearch", "resource": "*", "effect": "deny" }
      ]
    },
    "completeness-voter": {
      "description": "โหวต APPROVE/DENY ด้านความครบถ้วนเอกสาร",
      "mode": "all",
      "steps": 10,
      "permissions": [
        { "action": "read", "resource": "pdf/**/*", "effect": "allow" },
        { "action": "read", "resource": "curriculums/**/*", "effect": "allow" },
        { "action": "read", "resource": "reports/**/*", "effect": "allow" },
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "grep", "resource": "*", "effect": "allow" },
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "webfetch", "resource": "*", "effect": "deny" },
        { "action": "websearch", "resource": "*", "effect": "deny" }
      ]
    }
  }
}
