{
  "$schema": "https://opencode.ai/config.json",
  // เอเจนต์ทั้งหมดนิยามที่ .opencode/agents/*.md ที่เดียว (ตาม docs ไม่นิยามซ้ำสองที่)
  // โมเดลดีฟอลต์อยู่ใน frontmatter ของแต่ละเอเจนต์ (opencode/space-bunny-free = ฟรี ไม่เก็บข้อมูลไปเทรน)
  // เปลี่ยนโมเดลต่อรอบด้วย Variables: OPENCODE_MODEL
  "default_agent": "auditor"
}
